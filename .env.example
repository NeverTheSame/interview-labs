DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
PORT=8090
# Encrypts secrets saved on the /settings page. Without it the
# key is derived from the DATABASE_URL password.
# R3_SETTINGS_KEY=""
# Sign-in: off (or 0/false/no) only behind another app's authenticated proxy.
# R3_AUTH="on"
# Operator accounts besides the first one created (comma-separated, any case).
# R3_ADMIN_ACCOUNTS=""

# --- Controller chat (optional; the other pages work without it) -----------
# Models are "provider:name". A provider is offered when its key is set.
OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""
R3_CHAT_MODEL="openrouter:openrouter/free"
# The picker, as "id=Label" entries; the default is added when missing.
# R3_CHAT_MODELS="openrouter:openrouter/free=OpenRouter free,openrouter:openai/gpt-4.1-mini=GPT-4.1 mini,openai:gpt-4.1-mini=OpenAI GPT-4.1 mini"
# R3_CHAT_ALLOW_CUSTOM_MODELS=1        # let the picker take any openrouter:/openai: id
# R3_CHAT_INCLUDE_CONTEXT=1            # default for "Include portal summary"
# The pre-agent form still works: a bare R3_CHAT_MODEL plus R3_CHAT_BASE_URL
# names the provider (openrouter.ai → openrouter, otherwise openai).

# --- Workflow detection ------------------------------------------------------
# rules (no model) | llm (default: the chat model) | jev (TypeSafe's Jev) | hybrid (Jev, LLM below the floor)
# R3_ROUTER_MODE="llm"
# R3_ROUTER_MODEL=""                   # empty = the turn's chat model
# TYPESAFE_API_KEY=""                  # enables jev / hybrid
# R3_TYPESAFE_MODEL="typesafe:jev-latest"
# R3_JEV_CONFIDENCE=0.6                # hybrid falls back to the LLM below this

# The Temporal worker runs inside the portal process by default; set 0 to run
# `uv run r3-worker` separately.
# R3_EMBED_WORKER=1

# --- Runs: Temporal (optional) ------------------------------------------------
# Without TEMPORAL_ADDRESS, runs execute inside the portal process (in memory,
# lost on restart). With it, runs are Temporal workflows executed by the
# worker inside the portal (or `uv run r3-worker`).
# Temporal Cloud with an API key (namespace endpoint, or the regional one,
# e.g. us-west-2.aws.api.temporal.io:7233, then also set TEMPORAL_UI_URL):
# TEMPORAL_ADDRESS="<namespace>.<account>.tmprl.cloud:7233"
# TEMPORAL_NAMESPACE="<namespace>.<account>"
# TEMPORAL_API_KEY=""
# ...or an mTLS namespace: PEM file paths, or the PEM text itself.
# TEMPORAL_TLS_CERT="/path/to/client.pem"
# TEMPORAL_TLS_KEY="/path/to/client.key"
# TEMPORAL_TASK_QUEUE="r3-controller"
# Links to runs; derived for *.tmprl.cloud and localhost when empty.
# TEMPORAL_UI_URL="https://cloud.temporal.io/namespaces/<namespace>.<account>/workflows"
# auto (Temporal when configured, else in-process) | temporal | local | none
# R3_RUNS_BACKEND="auto"
# Local development: `uv run r3-temporal-dev` (UI on http://localhost:8233), then
# TEMPORAL_ADDRESS="localhost:7233"

